# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# (Settings -> API no dashboard, ou o que o `supabase start` imprime no local.)

# URL do projeto Supabase (ex.: https://xxxx.supabase.co ou http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=""

# anon/public key — segura para o browser (a RLS é quem protege os dados)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Usado só pelo script `npm run gen:types` (supabase gen types). Não vai pro browser.
SUPABASE_PROJECT_ID=""
